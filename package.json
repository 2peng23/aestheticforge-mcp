{
  "name": "aestheticforge-mcp",
  "version": "0.1.0",
  "description": "Local, evidence-based interface engineering MCP server",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.20"
  },
  "bin": {
    "aestheticforge-mcp": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "scripts",
    "references",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/executable.mjs",
    "test": "vitest run",
    "demo": "npm run build && tsx examples/run-demo.ts",
    "smoke": "tsx tests/protocol-smoke.ts",
    "prepare": "npm run build",
    "browser-test": "npm run build && tsx tests/browser-boundaries.ts",
    "tools-doc": "npm run build && node scripts/tool-reference.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/server": "2.4.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^20.19.0",
    "@types/pngjs": "6.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
